# Copy this file to .env and fill in values for local development.
# .env is gitignored and never committed.

# PostgreSQL (Docker Compose)
POSTGRES_USER=mbta_casino
POSTGRES_PASSWORD=hunter2
POSTGRES_DB=mbta_casino
DATABASE_URL=postgres://mbta_casino:hunter2@localhost:5432/mbta_casino

# Redis (Docker Compose)
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_SECRET_KEY=replace-me-with-a-random-string
DJANGO_DEBUG=true

# MBTA v3 API — optional for local dev (unauthenticated requests have lower rate limits)
# Get a key at https://api-v3.mbta.com/
MBTA_API_KEY=
